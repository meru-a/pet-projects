                  {
                    "value": "Based on the results, we reject the null hypothesis at conventional significance levels (α = 0.05). The ",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#506d97"
                    }
                  },
                  {
                    "value": "difference was statistically significant",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#506d97"
                    }
                  },
                  {
                    "value": " (z = −10.59, p < 0.001), with non-overlapping 95% confidence intervals.",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#506d97"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "We can conclude that",
                    "textStyle": {
                      "fontSize": "11pt",
                      "color": "#506d97"
                    }
                  },
                  {
                    "value": " there is no statistically significant evidence that treatment effectiveness varies with ad exposure.",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "11pt",
                      "color": "#506d97"
                    }
                  }
                ],
                "listType": "bullet"
