		annotation SummarizationSetBy = Automatic

	partition Calendar = calculated
		mode: import
		source = ```
				ADDCOLUMNS(
				CALENDAR(date(year(min(min('EVENTS'[TIMESTAMP]), min('EVENTS'[TIMESTAMP]))),1,1),
				DATE(year(max(max('EVENTS'[TIMESTAMP]),max('EVENTS'[TIMESTAMP]))),12,31)), 
				"Year", year([Date]),
				"MonthNumber",  month([Date]),
				"Month", format([Date], "mmmm"), 
				"YearMonth", FORMAT([Date], "yyyy-mm"),
				"Quarter", "Qtr " & FORMAT([Date], "q"),
				"WeekDayNum", WEEKDAY([Date], 2),
				"WeekDayEngShort", 
				IF(WEEKDAY([Date], 2) = 1, "Mon",
				IF(WEEKDAY([Date], 2) = 2, "Tue",
				IF(WEEKDAY([Date], 2) = 3, "Wed",
				IF(WEEKDAY([Date], 2) = 4, "Thu",
				IF(WEEKDAY([Date], 2) = 5, "Fri",
				IF(WEEKDAY([Date], 2) = 6, "Sat","Sun"
				)))))), 
				"WorkDay", SWITCH(WEEKDAY([Date], 2), 6, "Weekend", 7, "Weekend", "Workday"),
				"WeekNumber", WEEKNUM([Date])
				)
				```

	annotation PBI_Id = e001814b871245f7b920efe45c598b8f

