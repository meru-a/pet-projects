	column 'RFM_SCORE (bins)' =
			IF(
				ISBLANK('FCT_CUSTOMER_SEGMENTS'[RFM_SCORE]),
				BLANK(),
				IF(
					'FCT_CUSTOMER_SEGMENTS'[RFM_SCORE] >= 0,
					ROUNDDOWN('FCT_CUSTOMER_SEGMENTS'[RFM_SCORE] / 100, 0) * 100,
					ROUNDUP('FCT_CUSTOMER_SEGMENTS'[RFM_SCORE] / 100, 0) * 100
				)
			)
		lineageTag: 53a5ee90-7374-4bb3-9256-8714cb7569b6
		summarizeBy: none

		extendedProperty GroupingMetadata =
				{
				  "version": 0,
				  "groupedColumns": [
				    {
				      "Column": {
				        "Expression": {
				          "SourceRef": {
				            "Entity": "FCT_CUSTOMER_SEGMENTS"
				          }
				        },
				        "Property": "RFM_SCORE"
				      }
				    }
				  ],
				  "binningMetadata": {
				    "binSize": {
				      "value": 100.0,
				      "unit": 0
				    }
				  }
				}

		annotation GroupingDesignState = {"Version":0,"Sources":[{"Name":"f","Entity":"FCT_CUSTOMER_SEGMENTS"}],"GroupedColumns":[{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"RFM_SCORE"}}],"BinItem":{"Expression":{"Floor":{"Expression":{"Column":{"Expression":{"SourceRef":{"Source":"f"}},"Property":"RFM_SCORE"}},"Size":100.0}}}}

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'RFM Segment' =
			
			SWITCH(
			    TRUE(),
			
			    [R_SCORE] >= 4 &&
			    [F_SCORE] >= 4 &&
			    [M_SCORE] >= 4,
			    "Champions",
			
			    [R_SCORE] <= 2 &&
			    [F_SCORE] >= 4 &&
			    [M_SCORE] >= 4,
			    "Can't Lose Them",
			
			    [R_SCORE] >= 3 &&
			    [F_SCORE] >= 4,
			    "Loyal Customers",
			
			    [R_SCORE] = 5 &&
			    [F_SCORE] <= 2,
			    "New Customers",
			
			    [R_SCORE] >= 4 &&
			    [F_SCORE] >= 2,
			    "Potential Loyalists",
			
			    [R_SCORE] >= 2 &&
			    [R_SCORE] <= 3 &&
			    [F_SCORE] >= 3,
			    "At Risk",
			
			    [R_SCORE] <= 2 &&
			    [F_SCORE] <= 2 &&
			    [M_SCORE] <= 2,
			    "Hibernating",
			
			    [R_SCORE] = 1 &&
			    [F_SCORE] <= 2,
			    "Lost",
			
			    "Other"
			)
		lineageTag: d4a1728d-e536-4ec5-8af4-1400c77c5032
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

